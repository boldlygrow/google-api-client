{
    "name": "provisionesta/google-api-client",
    "description": "Google API Client for Laravel",
    "homepage": "https://gitlab.com/provisionesta/google-api-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Dillon Wheeler"
        },
        {
            "name": "Jefferson Martin",
            "email": "provisionesta@jeffersonmartin.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/config": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/log": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "nesbot/carbon": "^2.67 || ^3.0",
        "provisionesta/audit": "^1.1"
    },
    "require-dev": {
        "orchestra/testbench": "^6.23 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "larastan/larastan": "^2.7 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Provisionesta\\Google\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Provisionesta\\Google\\GoogleApiServiceProvider"
            ]
        }
    }
}
