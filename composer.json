{
    "name": "boldlygrow/google-api-client",
    "description": "Google API Client for Laravel",
    "homepage": "https://github.com/boldlygrow/google-api-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Dillon Wheeler"
        },
        {
            "name": "Jeff Martin",
            "email": "jeff@boldlygrow.us"
        }
    ],
    "replace": {
        "glamstack/google-api-client": "self.version",
        "provisionesta/google-api-client": "self.version"
    },
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "boldlygrow/audit-log": "^2.0 || ^3.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^3.8 || ^4.7",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.1"
    },
    "autoload": {
        "psr-4": {
            "BoldlyGrow\\Google\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoldlyGrow\\Google\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "bin/test_code_style.sh",
        "analyse": "bin/test_phpstan.sh",
        "prerelease": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test_prerelease.sh"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the Pest test suite.",
        "test:coverage": "Run the Pest test suite with code coverage.",
        "lint": "Check code style with Laravel Pint.",
        "analyse": "Run PHPStan (Larastan) at the level in phpstan.neon.",
        "prerelease": "Run every check that CI runs: composer validate, Pint, PHPStan, Pest, and composer audit."
    },
    "extra": {
        "laravel": {
            "providers": [
                "BoldlyGrow\\Google\\GoogleApiServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
