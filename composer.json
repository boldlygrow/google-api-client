{
    "name": "provisionesta/google-api-client",
    "description": "Google API Client for Laravel",
    "homepage": "https://gitlab.com/provisionesta/google-api-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Dillon Wheeler"
        },
        {
            "name": "Jefferson Martin",
            "email": "provisionesta@jeffersonmartin.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "boldlygrow/audit-log": "^2.0",
        "nesbot/carbon": "^2.72.2 || ^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "larastan/larastan": "^2.9 || ^3.0",
    },
    "autoload": {
        "psr-4": {
            "Provisionesta\\Google\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Provisionesta\\Google\\GoogleApiServiceProvider"
            ]
        }
    }
}
